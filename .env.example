# Neon Postgres connection string (server-side only)
DATABASE_URL=
# Google AI Studio keys, comma-separated, tried in order (put your fallback key last)
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-pro-preview
RESEND_API_KEY=
# Without a verified domain use onboarding@resend.dev (Resend then only delivers to your own Resend account email)
RESEND_FROM=
RESEND_REPLY_TO=
# Password for the dashboard login
APP_PASSWORD=
# Test mode: while set, every email goes here instead of the candidate (use your Resend signup email)
RESEND_TEST_TO=
